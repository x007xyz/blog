---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const { title = "极简博客", description = "我的个人博客" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="bg-white text-slate-900 font-serif selection:bg-slate-100">
		<div class="max-w-4xl mx-auto px-6 py-12 md:py-20">
			<header class="mb-12">
				<nav>
					<a href="/" class="text-xl font-bold hover:text-slate-600 transition-colors">
						Minimal Blog
					</a>
				</nav>
			</header>

			<main>
				<slot />
			</main>

			<footer class="mt-32 pt-12 border-t border-gray-50 text-[10px] tracking-[0.2em] uppercase text-gray-300">
				<p>© {new Date().getFullYear()} Minimal Blog. Built with Astro.</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	@reference "../styles/global.css";

	:root {
		--font-serif: "Georgia", "Times New Roman", serif;
	}
	
	body {
		font-family: var(--font-serif);
		line-height: 1.6;
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		line-height: 1.2;
		@apply font-bold mt-8 mb-4;
	}

	h1 { @apply text-3xl; }
	h2 { @apply text-2xl; }
	h3 { @apply text-xl; }

	p { @apply mb-4; }

	a { @apply transition-colors; }

	pre {
		@apply p-6 rounded-2xl bg-gray-50/50 overflow-x-auto text-sm my-8 border border-gray-100 shadow-sm;
	}
	
	code {
		@apply font-mono px-1.5 py-0.5 bg-gray-100/50 rounded-md text-[0.9em] text-slate-800;
	}
	
	pre code {
		@apply p-0 bg-transparent text-inherit;
	}

	ul { @apply list-disc list-inside mb-4; }
	ol { @apply list-decimal list-inside mb-4; }
</style>
